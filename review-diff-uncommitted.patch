+
+String _availabilityLabel(Property property) {
+  final String tag = property.tag.trim().toLowerCase();
+
+  if (tag.contains('sold')) return 'Sold';
+  if (tag.contains('auction')) return 'For Auction';
+
+  return 'Available';
+}
+
+Color _availabilityColor(BuildContext context, String label) {
+  final ColorScheme colorScheme = Theme.of(context).colorScheme;
+
+  switch (label) {
+    case 'Sold':
+      return colorScheme.error;
+    case 'For Auction':
+      return const Color(0xFFF59E0B);
+    default:
+      return colorScheme.primary;
+  }
+}
