+int _daysRemaining(DateTime value) {
+  final Duration diff = value.toLocal().difference(DateTime.now());
+  if (diff.isNegative) return 0;
+  if (diff.inHours < 24) return 1;
+  return diff.inDays + (diff.inHours % 24 == 0 ? 0 : 1);
 }
 
